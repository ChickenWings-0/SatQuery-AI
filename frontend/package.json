{
  "name": "satquery-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../openapi.json -o src/api/schema.d.ts",
    "fonts:sync": "cp node_modules/@fontsource-variable/geist/files/geist-latin-wght-normal.woff2 node_modules/@fontsource-variable/geist/files/geist-latin-ext-wght-normal.woff2 node_modules/@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2 node_modules/@fontsource-variable/geist-mono/files/geist-mono-latin-ext-wght-normal.woff2 public/fonts/",
    "test:e2e": "playwright test",
    "prebuild": "node scripts/gen-public-meta.mjs",
    "gen:meta": "node scripts/gen-public-meta.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@xyflow/react": "^12.11.6",
    "dagre": "^0.8.5",
    "idb-keyval": "^6.3.0",
    "maplibre-gl": "^6.9.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-compare-slider": "^4.0.0",
    "react-dom": "^19.2.8",
    "react-zoom-pan-pinch": "^4.2.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.14.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.79.0",
    "playwright": "^1.63.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "@oxlint/binding-linux-x64-gnu": "1.79.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
