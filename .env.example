# SatQuery AI — local serving configuration.
#
# Copy to .env (git-ignored). pydantic-settings reads every SATQUERY_* variable
# at startup, so `uvicorn satquery.api.app:app` and `make demo` need no exports.

# --- VLM backend ------------------------------------------------------------
# hf        transformers in-process: bf16 base + LoRA adapter (~18.7 GiB peak, 24 GB card)
# llamacpp  llama-server holding a Q4_K_M GGUF (~6 GB, the air-gapped laptop path)
# none      VLM disabled, templated answers (make demo-cpu)
SATQUERY_VLM_BACKEND=hf
SATQUERY_VLM_ADAPTER_PATH=runs/sq-lora-v2-full/adapter

# For the llama.cpp path instead (start it with scripts/serve_vlm.sh, or
# scripts/serve_vlm.ps1 on the Windows demo laptop):
# SATQUERY_VLM_BACKEND=llamacpp
# SATQUERY_VLM_SERVER_URL=http://127.0.0.1:8080

# Views per prompt, at most 6 (the training budget). The 8 GB demo laptop
# serves the GGUF at 8192 context and gets 3 — see scripts/demo_laptop/README.md.
# SATQUERY_VLM_MAX_VIEWS=6

# --- Specialist checkpoints --------------------------------------------------
# Only explicitly configured checkpoints count as servable; without these the
# registry drops the tool and plans degrade to spectral indices / image diff.
SATQUERY_SEG_CHECKPOINT=data/checkpoints/seg/segformer-b5-loveda
# SATQUERY_CD_CHECKPOINT=data/checkpoints/cd/<siamese-checkpoint>

# --- Stores ------------------------------------------------------------------
# SATQUERY_TRACE_DB=data/traces.sqlite3
# SATQUERY_ARTIFACT_ROOT=data/artifacts
# SATQUERY_CACHE_MB=2048
