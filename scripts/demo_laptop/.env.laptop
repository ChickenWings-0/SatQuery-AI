# SatQuery AI — .env for the air-gapped Windows demo laptop (RTX 4070, 8 GB).
# Copied to the repository root as .env by step 4 of DOCS/DEMO_LAPTOP_RUNBOOK.md.

# The Q4_K_M GGUF behind llama-server (scripts/serve_vlm.ps1). No torch here.
SATQUERY_VLM_BACKEND=llamacpp
SATQUERY_VLM_SERVER_URL=http://127.0.0.1:8080

# Three 448 px views per prompt, not six: the server runs at 8192 context and
# each view is ~1024 image tokens. The trace records the cap (views_ceiling).
SATQUERY_VLM_MAX_VIEWS=3

# Specialist checkpoints — without them the registry drops the tools and the
# change / segmentation plans degrade to image diff / spectral indices.
SATQUERY_SEG_CHECKPOINT=data/checkpoints/seg/segformer-b5-loveda
SATQUERY_CD_CHECKPOINT=data/checkpoints/cd/levircd_resnet18.ckpt.pt
